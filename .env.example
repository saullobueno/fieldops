NODE_ENV=development
WEB_PORT=3000
MOBILE_WEB_PORT=3001
API_PORT=4000
ATTACHMENT_STORAGE_ROOT=storage
ATTACHMENT_URL_SECRET=fieldops-demo-secret
# Origens autorizadas a chamar a API com cookies. Em produção, troque pelos
# domínios públicos do Vercel separados por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Padrão: Postgres local via `docker compose up -d` (ver README).
# Produção/nuvem gratuita: connection string do Neon (já inclui sslmode=require).
DATABASE_URL=postgres://fieldops:fieldops@localhost:5432/fieldops
# Padrão: Redis local via `docker compose up -d` (ver README).
# Produção/nuvem gratuita: connection string rediss:// do Upstash.
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
# Opcional: URL de um servidor OSRM (ex.: https://router.project-osrm.org) para estimativas
# de rota reais no despacho. Sem essa variável, o adaptador mock determinístico é usado.
MAPS_PROVIDER_BASE_URL=
# Opcional: habilita bloqueios externos de calendário no despacho.
# Valores atuais: vazio (desabilitado) ou mock (adaptador determinístico).
CALENDAR_PROVIDER=
# Opcional: chave da Groq (free tier) para o copiloto de IA usar o modelo real
# em vez do fallback heurístico. Sem essa variável, o copiloto continua funcionando
# com heurísticas determinísticas.
GROQ_API_KEY=
# Opcional: chave pública do MapTiler (free tier) para renderizar tiles reais no mapa.
NEXT_PUBLIC_MAPTILER_KEY=
# Opcional: token do Upstash Blob (free tier, sem cartao no plano gratuito) para
# armazenar anexos na nuvem em vez de disco local. Use bucket privado para que o
# download continue passando por URL assinada. Sem essa variável, o storage local
# (ATTACHMENT_STORAGE_ROOT) continua sendo usado.
UPSTASH_BLOB_TOKEN=
